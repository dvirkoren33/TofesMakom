<?xml version="1.0" encoding="utf-8"?>
<!-- Layout ראשי בצורת LinearLayout אנכי שסודר את כל הרכיבים מלמעלה למטה -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- הודעת ברכה ושם השחקן -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="בהצלחה! המשחק מתחיל..."
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- תיבת הקלדה להזנת שם היישוב -->
    <EditText
        android:id="@+id/etCityGuess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="הקלד שם של יישוב..."
        android:inputType="textPersonName"
        android:textSize="16sp" />

    <!-- כפתור שליחת ניחוש לבדיקה -->
    <Button
        android:id="@+id/btnSubmitGuess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="שלח ניחוש"
        android:layout_marginTop="8dp" />

    <!-- רכיב ה-RecyclerView המציג את הניחושים התקנים של השחקן -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGuesses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>